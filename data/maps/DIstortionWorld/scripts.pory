raw `DIstortionWorld_MapScripts::
	.byte 0
`

script Legendary_EventScript_GIRATINA {
    lockall
    if (checkitem(ITEM_GRISEOUS_CORE)) {
        msgbox(format("The Griseous Core grows heavy, then weightless, then heavy again. The shadows here point the wrong way..."))
        msgbox(format("Set down the Core?"), MSGBOX_YESNO)
        switch (var(VAR_RESULT)) {
            case YES:
                clearflag(FLAG_GIRATINA_BATTLE)
                addobject(1)
                msgbox(format("The world peels back like a wound. You're in a world that should not exist."), MSGBOX_AUTOCLOSE)
                fadescreenswapbuffers(FADE_TO_BLACK)
                delay(40)
                fadescreenswapbuffers(FADE_FROM_BLACK)
                playmoncry(SPECIES_GIRATINA, CRY_MODE_ENCOUNTER)
                applymovement(1, GIRATINA_Descend)
                waitmovement(0)
                msgbox(format("From the reverse side of everything, the Renegade returns to glare at the world that exiled it."), MSGBOX_AUTOCLOSE)
                playmoncry(SPECIES_GIRATINA, CRY_MODE_ENCOUNTER)
                delay(40)
                waitmoncry
                setwildbattle(SPECIES_GIRATINA_ORIGIN, 80)
                special(BattleSetup_StartLegendaryBattle)
                waitstate
                specialvar(VAR_RESULT, GetBattleOutcome)
                if (var(VAR_RESULT) == B_OUTCOME_CAUGHT) {
                    call(GIRATINAWon_or_Caught)
                } elif (var(VAR_RESULT) == B_OUTCOME_WON) {
                    call(GIRATINAWon_or_Caught)
                } elif (var(VAR_RESULT) == B_OUTCOME_RAN) {
                    call(GIRATINARanAway)
                } elif (var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
                    call(GIRATINARanAway)
                }
                releaseall
                end
            case NO:
                msgbox(format("...No. Not yet. Maybe not ever."))
                releaseall
                end
        }
    }
    msgbox(format("This place is too quiet. The kind of quiet that's watching back."))
    releaseall
    end
}

script GIRATINAWon_or_Caught {
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(1)
    setvar (VAR_TEMP_0, 1)
    setflag(FLAG_GIRATINA_DFTD)
    completequest(QUEST_GIRATINA)
    setflag(FLAG_GIRATINA_BATTLE)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox(format("The wound in the world seals. The shadows point the right way again... mostly."))
    return
}

script GIRATINARanAway {
    playmoncry(SPECIES_GIRATINA, CRY_MODE_ENCOUNTER)
    delay(20)
    fadescreenswapbuffers(FADE_TO_BLACK)
    hideobjectat(1, MAP_DISTORTION_WORLD)   // session-only: leaves FLAG_GIRATINA_BATTLE clear so the mon respawns for a retry
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox(format("It slipped back through to the other side."))
    return
}

movement GIRATINA_Descend {
    walk_down * 7
    delay_16
    face_player
}

script RETURN_HOME_HYPNO {
    lock
    faceplayer
    msgbox(format("Would you like to end this nightmare?"), MSGBOX_YESNO)
    switch (var(VAR_RESULT)) {
        case YES:
            msgbox(format("Stare into my pendulum."))
            closemessage
            fadescreen(FADE_TO_BLACK)
            delay(60)
            // Adjust the map + coords above to point at your island.
            warp(MAP_LITTLEROOT_TOWN, 5, 8)
            waitstate
        case NO:
            msgbox(format("Not very wise."))
    }
    release
    end
}

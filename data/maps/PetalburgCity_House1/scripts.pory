raw `PetalburgCity_House1_MapScripts::
	.byte 0

PetalburgCity_House1_EventScript_Man::
	msgbox PetalburgCity_House1_Text_TravelingIsWonderful, MSGBOX_NPC
	end

PetalburgCity_House1_EventScript_Woman::
	msgbox PetalburgCity_House1_Text_GoOnAdventure, MSGBOX_NPC
	end

PetalburgCity_House1_Text_TravelingIsWonderful:
	.string "Traveling is wonderful!\p"
	.string "When I was young, I roamed the seas\n"
	.string "and the mountains!$"

PetalburgCity_House1_Text_GoOnAdventure:
	.string "Sigh…\p"
	.string "I wish I could go on an adventure\n"
	.string "with some POKéMON…\p"
	.string "Crawl through some damp grass…\n"
	.string "Climb rocky, rugged mountains…\p"
	.string "Cross the raging seas…\n"
	.string "Wander about in dark caves…\p"
	.string "And, sometimes, even get a little\n"
	.string "homesick…\p"
	.string "It must be fabulous to travel!$"

`

script PetalburgCity_House1_EventScript_Scientist {
    lock
    faceplayer
    if (flag(FLAG_DEXNAV_GET)) {
        if (flag(FLAG_DEXNAV_SHOW_ALL)) {
            msgbox(format("So, has my DexNav app been pulling its weight?\p"
                          "Sniffing out those sneaky POKéMON hiding in the"
                          "grass has to be paying off by now, right?\p"
                          "Data, data! Tell me it's been useful!"))
            release
            end
        }
        msgbox(format("Say, I've been tinkering with the DexNav some more!\p"
                      "I can push a premium update that reveals EVERY"
                      "POKéMON living on a route… even ones you've never"
                      "laid eyes on.\p"
                      "The research licensing isn't cheap, though.\n"
                      "I'll need ¥50000 to cover it.\p"
                      "Shall I install the upgrade?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == NO) {
            msgbox(format("No pressure! The offer stands whenever you're"
                          "ready."))
            release
            end
        }
        checkmoney(50000)
        if (var(VAR_RESULT) == FALSE) {
            msgbox(format("Hmm, you're a little short on funds.\n"
                          "Come back once you've saved up ¥50000!"))
            release
            end
        }
        showmoneybox(0, 0)
        removemoney(50000)
        updatemoneybox()
        playfanfare(MUS_OBTAIN_ITEM)
        setflag(FLAG_DEXNAV_SHOW_ALL)
        waitfanfare
        msgbox(format("There! The DexNav upgrade is installed.\p"
                      "Now it'll list every POKéMON on the route,\n"
                      "seen or not. Happy hunting!"))
        hidemoneybox()
        release
        end
    }
    msgbox(format("Oho! A fellow traveler with a ROTOM PHONE!\p"
                  "I've just finished coding a brand-new app for it.\n"
                  "I call it the DexNav!\p"
                  "It scans the area for POKéMON lurking nearby, so you'll"
                  "never walk past a rare one again.\p"
                  "Want me to install it onto your ROTOM PHONE?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("No pressure! Swing by whenever you'd like it."))
        release
        end
    }
    playfanfare(MUS_OBTAIN_ITEM)
    setflag(FLAG_DEXNAV_GET)
    waitfanfare
    msgbox(format("There! The DexNav is now installed.\p"
                  "You'll find it inside your ROTOM PHONE.\n"
                  "Go put it to good use!"))
    release
    end
}
